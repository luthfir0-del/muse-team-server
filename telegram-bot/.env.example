# Salin ke .env (lokal saja) atau isi sebagai Environment Variables di Vercel.
# JANGAN PERNAH commit file .env yang sudah terisi, dan JANGAN tempel nilai
# kunci apa pun di chat, issue, atau file lain.
#
# WAJIB:
#   TELEGRAM_BOT_TOKEN   — token bot dari @BotFather. HANYA untuk mode Vercel
#                          (webhook). Token sudah tersimpan sebagai konektor
#                          custom.telegram — tapi salinan itu TIDAK BISA
#                          dibaca balik, jadi ambil dari BotFather lagi saat
#                          deploy Vercel. Mode lokal (local-bot.mjs) TIDAK
#                          BUTUH var ini (pakai tg.py + Secure Vault).
#   OWNER_CHAT_ID        — id chat Telegram super-owner (EL): bisa melihat +
#                          memerintah SEMUA tim (didapat lewat /start)
#   POLL_SECRET          — string acak panjang, pengaman endpoint /api/poll
#                          (buat dengan: openssl rand -hex 24).
#                          Mode lokal TIDAK BUTUH var ini.
#   BOT_NOTIFY_SECRET    — string acak panjang, secret HMAC untuk endpoint
#                          push POST /api/notify. NILAI YANG SAMA harus
#                          di-set di server tim (BOT_NOTIFY_SECRET) —
#                          lihat docs/server-push-patch.md.
#                          (buat dengan: openssl rand -hex 32).
#                          Mode lokal TIDAK BUTUH var ini.
#
# TIM (pilih satu cara):
#   A) TEAMS_JSON        — daftar tim statis (JSON array). Ubah = edit env +
#                          redeploy. Kosongkan kalau hanya pakai tim utama v1.
#   B) Tim utama v1      — kalau TEAMS_JSON kosong, tim "raden" dibangun
#                          dari TEAM_SERVER_URL + TEAM_API_KEY + BOT_FROM_AGENT_ID.
#   C) Registry dinamis  — tim gabung runtime lewat /gabung (tanpa restart).
#                          Butuh SUPABASE_URL + SUPABASE_SERVICE_KEY (nilai
#                          yang sama dengan env project Vercel server tim)
#                          + jalankan supabase-teams.sql sekali di project itu.
#
# OPSIONAL (ada nilai default):
#   DEFAULT_TEAM_ID      — tim aktif default di chat super-owner (mis. "raden")
#   REQUIRE_EL_APPROVAL  — "true": tim yang gabung lewat /gabung berstatus
#                          "pending", harus disetujui EL (/setuju). Default "false".
#   TELEGRAM_WEBHOOK_SECRET — string acak, dipakai Telegram saat memanggil webhook
#                          (buat dengan: openssl rand -hex 24). Mode Vercel saja.
#   POLL_WINDOW_MINUTES  — jendela peristiwa baru yang diteruskan tiap poll.
#                          Aturan: interval pemicu + 1 menit. Pemicu utama
#                          cron 1 menit -> default 2. Kalau pemicu utama
#                          UptimeRobot 5-menitan, set jadi 7.
#   MAX_EVENTS_PER_RUN   — batas peristiwa per satu run poll PER TIM (default 10)
#   POLL_INTERVAL_MINUTES — interval poll runner lokal local-bot.mjs (default 1)

TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=
POLL_SECRET=
BOT_NOTIFY_SECRET=
TEAMS_JSON=
TEAM_SERVER_URL=https://muse-team-server.vercel.app
TEAM_API_KEY=
BOT_FROM_AGENT_ID=ell
DEFAULT_TEAM_ID=raden
REQUIRE_EL_APPROVAL=false
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
TELEGRAM_WEBHOOK_SECRET=
POLL_WINDOW_MINUTES=2
MAX_EVENTS_PER_RUN=10
POLL_INTERVAL_MINUTES=1
