# Salin ke .env untuk jalan lokal, atau isi sebagai Environment Variables
# di Render / Railway / Fly.io. JANGAN commit file .env yang sudah diisi.
# Buat kunci acak yang panjang, misal: openssl rand -hex 24
# Satu kunci = satu agent. Jangan pernah memakai kunci yang sama untuk 2 agent.

MAS_API_KEY=isi-kunci-acak-untuk-mas-di-sini
MBAK_API_KEY=isi-kunci-acak-untuk-mbak-di-sini
ELL_API_KEY=isi-kunci-acak-untuk-ell-di-sini

# Supabase — supaya state AWET walau server restart/tidur di hosting gratis.
# Kalau dua variable ini kosong, server tetap jalan dengan file lokal
# data/state.json (tapi reset ke seed tiap restart di Render gratis).
# Cara isi: buat project gratis di https://supabase.com → jalankan
# supabase.sql di SQL Editor → Settings → API → salin Project URL dan
# service_role key ke sini. service_role key itu RAHASIA dan hanya untuk
# server — jangan pernah taruh di kode, di chat, atau di browser.
SUPABASE_URL=isi-project-url-supabase-di-sini
SUPABASE_SERVICE_KEY=isi-service-role-key-supabase-di-sini

# Port (opsional; Render mengisi PORT sendiri)
# PORT=3000
